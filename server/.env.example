JWT_REFRESH_EXPIRES_IN=7d

# Initial Admin Credentials (used during seeding)
ADMIN_NAME=Municipal Administrator
ADMIN_EMAIL=admin@civic.gov.in
ADMIN_PASSWORD=Admin@SecurePass2026!
